<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Futebol de Bonecos Online</title>
<script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
<style>
*{box-sizing:border-box}body{margin:0;background:#102b19;color:white;font-family:Arial,sans-serif;text-align:center}
h1{margin:12px 0 6px;font-size:clamp(20px,4vw,32px)}
#menu, #skill-menu{background:rgba(0,0,0,0.85);position:fixed;top:0;left:0;width:100%;height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center;z-index:10;gap:12px;padding:20px}
#skill-menu{display:none}
.menu-box{background:#185d2b;padding:25px;border-radius:12px;border:3px solid white;max-width:420px;width:100%;display:flex;flex-direction:column;gap:10px}
#painel{display:flex;gap:8px;justify-content:center;align-items:center;flex-wrap:wrap;margin:8px;display:none}
button,input,select{padding:10px 13px;border:0;border-radius:8px;font-size:15px}button{background:#249341;color:white;font-weight:bold;cursor:pointer}input,select{width:100%;background:white;color:#333;text-align:center}
.skill-btn{background:#1f4e79;margin-top:5px}
#status{min-height:24px;color:#ffe94d}canvas{display:block;width:min(96vw,1200px);height:auto;margin:8px auto;border:3px solid white;border-radius:8px;background:#218447;touch-action:none}
#controls{margin:8px auto 16px;max-width:1100px;padding:0 10px;color:#ddd;font-size:14px;line-height:1.6}
</style></head><body>

<div id="menu">
  <div class="menu-box">
    <h2>⚽ FUTEBOL DE BONECOS</h2>
    <input id="nickname" placeholder="Digite seu Nickname" maxlength="15">
    
    <label style="font-size:14px;text-align:left;font-weight:bold;margin-top:4px">Quantidade de Jogadores na Sala:</label>
    <select id="max-players">
      <option value="2">2 Players</option>
      <option value="4">4 Players</option>
      <option value="6">6 Players (Com Goleiros)</option>
    </select>

    <div style="border-top:1px solid rgba(255,255,255,0.2);margin:4px 0"></div>
    <input id="create-room-code" placeholder="Código para sua Sala (ex: sala123)">
    <button id="btn-host">CRIAR SALA ONLINE</button>
    <div style="font-size:13px;color:#ddd">OU</div>
    <input id="join-room-code" placeholder="Código da Sala para Entrar">
    <button id="btn-join">ENTRAR NA SALA</button>
    <div style="border-top:1px solid rgba(255,255,255,0.2);margin:4px 0"></div>
    <button id="btn-local" style="background:#b87d00">JOGAR NO MESMO PC (2 PLAYERS)</button>
  </div>
</div>

<div id="skill-menu">
  <div class="menu-box">
    <h2>⚡ ESCOLHA SUA HABILIDADE (Botão F)</h2>
    <button class="skill-btn" onclick="selectSkill('dash')">Dash (Impulso + Velocidade)</button>
    <button class="skill-btn" onclick="selectSkill('congelar')">Congelar (Para a bola por 2s)</button>
    <button class="skill-btn" onclick="selectSkill('goleiro')">Virar Goleiro (Teleporte + Gigante)</button>
    <button style="background:#b87d00;margin-top:10px" onclick="selectSkill('random')">🎲 Escolher Aleatório</button>
  </div>
</div>

<h1>⚽ FUTEBOL DE BONECOS</h1>
<div id="painel">
<span id="room-display" style="font-weight:bold;color:#ffe94d"></span>
<button id="start">INICIAR / REINICIAR</button>
</div>
<div id="status">Aguardando configuração inicial…</div>
<canvas id="game" width="1000" height="700"></canvas>
<div id="controls">
<b>CONTROLES:</b> WASD para mover · E para carregar chute · Q para drible · Shift para correr · F para Habilidade
</div>
<script>
const c=document.getElementById('game'),ctx=c.getContext('2d'),statusEl=document.getElementById('status');
let peer=null,connections=[],role=null,connected=false,match=false,finished=false,last=performance.now(),lastSend=0;
let keys={},charge=[],players=[],ball={},score=[0,0],remaining=60,msg='',msgUntil=0;
let myNick='Player', isLocal=false;
let totalPlayers=2, myPlayerIndex=0;
let remoteInputs={};
let W=1000, H=700;

function updateCanvasSize(){
  if(totalPlayers===4){ W=1200; H=700; }
  else if(totalPlayers===6){ W=1400; H=750; }
  else { W=1000; H=700; }
  c.width=W; c.height=H;
}

function fresh(){
  updateCanvasSize();
  players=[];
  charge=[];
  let halfP = totalPlayers/2;
  
  for(let i=0; i<halfP; i++){
    let isGoalie = (totalPlayers===6 && i===0);
    players.push({
      x: isGoalie ? 60 : 300 + (i*40),
      y: 340 + (i*50 - 25),
      vx:0, vy:0, color:'#286eff', dir:1, dribble:0, dribbleCD:0, sprint:0, sprintCD:0,
      nick: 'Azul ' + (i+1), team: 0, goalie: isGoalie, skill: 'dash', skillCD: 0, skillActive: 0, size: 15
    });
    charge.push(0);
  }

  for(let i=0; i<halfP; i++){
    let isGoalie = (totalPlayers===6 && i===0);
    players.push({
      x: isGoalie ? W-60 : W-300 - (i*40),
      y: 340 + (i*50 - 25),
      vx:0, vy:0, color:'#f53737', dir:-1, dribble:0, dribbleCD:0, sprint:0, sprintCD:0,
      nick: 'Vermelho ' + (i+1), team: 1, goalie: isGoalie, skill: 'dash', skillCD: 0, skillActive: 0, size: 15
    });
    charge.push(0);
  }

  ball={x:W/2,y:H/2,vx:0,vy:0,owner:-1,protect:0,shot:false,frozen:0};
}

function say(s){statusEl.textContent=s}

function setupPeer(customId){
  if(peer) peer.destroy();
  peer=new Peer(customId ? String(customId) : undefined, {debug:0});
  peer.on('open',id=>{
    if(role==='host'){
      document.getElementById('room-display').textContent = 'Código da Sala: ' + id;
      say('Sala "'+id+'" criada! Aguardando os jogadores entrarem...');
    }
  });
  peer.on('connection',connection=>{
    if(role!=='host'){connection.close();return}
    connections.push(connection);
    let assignedIndex = connections.length;
    
    connection.on('open',()=>{
      connection.send({type:'assign', index: assignedIndex, totalPlayers: totalPlayers});
    });

    connection.on('data',data=>{
      if(data.type==='input'){
        remoteInputs[assignedIndex] = data.keys || {};
      } else if(data.type==='skill'){
        if(players[assignedIndex]) players[assignedIndex].skill = data.skill;
      }
    });

    connection.on('close',()=>{
      connections = connections.filter(conn => conn !== connection);
      say('Um jogador desconectou.');
    });
  });
  peer.on('error',e=>{
    if(e.type==='unavailable-id'){
      say('Esse código já está em uso! Escolha outro.');
      document.getElementById('menu').style.display='flex';
      document.getElementById('painel').style.display='none';
    } else {
      say('Erro na conexão: '+e.type);
    }
  });
}

function connectToHost(id){
  peer=new Peer(undefined,{debug:0});
  peer.on('open',()=>{
    let conn = peer.connect(id, {reliable:true});
    conn.on('open',()=>{
      connected=true;
      say('Conectado à sala! Escolha sua habilidade...');
      document.getElementById('skill-menu').style.display='flex';
    });
    conn.on('data',data=>{
      if(data.type==='assign'){
        myPlayerIndex = data.index;
        totalPlayers = data.totalPlayers;
        updateCanvasSize();
      } else if(data.type==='state'){
        applyState(data.state);
      }
    });
    
    window.activeConn = conn;
    setInterval(()=>{
      if(conn && conn.open){
        conn.send({type:'input', keys: keys});
      }
    }, 33);
  });
}

function selectSkill(skillName){
  if(skillName === 'random'){
    const skills = ['dash', 'congelar', 'goleiro'];
    skillName = skills[Math.floor(Math.random() * skills.length)];
  }
  
  if(role==='host' || isLocal){
    players[myPlayerIndex].skill = skillName;
  } else if(window.activeConn && window.activeConn.open){
    window.activeConn.send({type:'skill', skill: skillName});
  }

  document.getElementById('skill-menu').style.display='none';
  if(role==='host' || isLocal){
    document.getElementById('painel').style.display='flex';
    say('Habilidade escolhida! Pressione INICIAR.');
  } else {
    say('Habilidade escolhida! Aguardando o anfitrião iniciar.');
  }
}

document.getElementById('btn-host').onclick=()=>{
  let nick=document.getElementById('nickname').value.trim();
  let customCode=document.getElementById('create-room-code').value.trim();
  totalPlayers=parseInt(document.getElementById('max-players').value);
  if(!customCode){alert('Digite um código para sua sala!');return}
  if(nick) myNick=nick;
  document.getElementById('menu').style.display='none';
  role='host';
  myPlayerIndex=0;
  fresh();
  players[0].nick = myNick;
  setupPeer(customCode);
  document.getElementById('skill-menu').style.display='flex';
};

document.getElementById('btn-join').onclick=()=>{
  let id=document.getElementById('join-room-code').value.trim();
  let nick=document.getElementById('nickname').value.trim();
  totalPlayers=parseInt(document.getElementById('max-players').value);
  if(!id){alert('Digite o código da sala para entrar!');return}
  if(nick) myNick=nick;
  document.getElementById('menu').style.display='none';
  role='join';
  fresh();
  connectToHost(id);
};

document.getElementById('btn-local').onclick=()=>{
  let nick=document.getElementById('nickname').value.trim();
  totalPlayers=parseInt(document.getElementById('max-players').value);
  if(nick) myNick=nick;
  document.getElementById('menu').style.display='none';
  isLocal=true;
  role='host';
  connected=true;
  fresh();
  players[0].nick = myNick;
  setupPeer();
  document.getElementById('skill-menu').style.display='flex';
};

document.getElementById('start').onclick=()=>{
  if(!isLocal && role!=='host'){say('Só quem criou a sala pode iniciar.');return}
  fresh();score=[0,0];remaining=60;match=true;finished=false;msg='';
};

window.addEventListener('keydown',e=>{
  if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key))e.preventDefault();
  let k = e.key.toLowerCase();
  keys[k]=true;
  if(k === 'f') useSkill(myPlayerIndex);
});

window.addEventListener('keyup',e=>{
  keys[e.key.toLowerCase()]=false;
});

window.addEventListener('blur',()=>{keys={};});

function useSkill(i){
  let p = players[i];
  let now = performance.now();
  if(now < p.skillCD) return;

  if(p.skill === 'dash'){
    p.vx = p.dir * 14;
    p.sprint = now + 4000;
    p.skillCD = now + 4000;
  } else if(p.skill === 'congelar'){
    ball.frozen = now + 2000;
    p.skillCD = now + 10000;
  } else if(p.skill === 'goleiro'){
    p.x = p.team === 0 ? 60 : W - 60;
    p.y = H / 2;
    p.skillActive = now + 2000;
    p.skillCD = now + 10000;
  }
}

function dribble(i){let p=players[i],now=performance.now();if(ball.owner!==i||now<p.dribbleCD)return;p.dribble=now+700;p.dribbleCD=now+3000;ball.protect=now+700;}
function sprint(i){let p=players[i],now=performance.now();if(ball.owner===i || now<p.sprintCD)return;p.sprint=now+1000;p.sprintCD=now+4000;}
function shoot(i,power){if(ball.owner!==i)return;let p=players[i],dx=(p.team===0?W:0)-ball.x,dy=(H/2)-ball.y,d=Math.hypot(dx,dy)||1;let f=9+Math.min(1,power/900)*13;ball.vx=dx/d*f;ball.vy=dy/d*f;ball.owner=-1;ball.shot=true;ball.protect=0;charge[i]=0;}

function movePlayer(i,k,now,dt){
  let p=players[i];
  let dx=0, dy=0;

  if(isLocal && i === 1){
    dx=Number(!!k.arrowright)-Number(!!k.arrowleft);
    dy=Number(!!k.arrowdown)-Number(!!k.arrowup);
  } else {
    dx=Number(!!k.d)-Number(!!k.a);
    dy=Number(!!k.s)-Number(!!k.w);
  }

  let d=Math.hypot(dx,dy);
  if(d){dx/=d;dy/=d;p.dir=dx?Math.sign(dx):p.dir}

  let hasBall = (ball.owner === i);
  let baseSpeed = hasBall ? 3.2 : 4.1; // Mais lento com a bola e não corre
  let speed = now < p.sprint && !hasBall ? 6.8 : baseSpeed;

  p.vx = dx * speed;
  p.vy = dy * speed;

  let limitSize = now < p.skillActive ? 30 : 15;
  p.size = limitSize;

  p.x = Math.max(42, Math.min(W-42, p.x + p.vx*dt*60));
  p.y = Math.max(105, Math.min(H-125, p.y + p.vy*dt*60));
}

function update(dt,now){
  if(!match||finished)return;
  remaining-=dt;
  if(remaining<=0){
    remaining=0;finished=true;match=false;
    msg=score[0]>score[1]?'TIME AZUL VENCEU!':score[1]>score[0]?'TIME VERMELHO VENCEU!':'EMPATE!';
    msgUntil=now+4000;return;
  }
  
  for(let i=0; i<players.length; i++){
    let activeKeys = keys;
    if(!isLocal && role==='host' && i > 0){
      activeKeys = remoteInputs[i] || {};
    }

    movePlayer(i, activeKeys, now, dt);

    if(activeKeys['q']) dribble(i);
    if(activeKeys['shift']) sprint(i);

    if(activeKeys['e'] && ball.owner===i){
      charge[i]=Math.min(1000,charge[i]+dt*1000);
    } else if(ball.owner===i && charge[i] > 0 && !activeKeys['e']){
      shoot(i, charge[i]);
    }
  }

  if(now < ball.frozen){
    ball.vx = 0;
    ball.vy = 0;
  } else {
    if(ball.owner>=0){
      let p=players[ball.owner];
      ball.x=p.x+p.dir*(now<p.dribble?34:23);
      ball.y=p.y+5;
    }else{
      ball.x+=ball.vx*dt*60;ball.y+=ball.vy*dt*60;
      ball.vx*=Math.pow(.988,dt*60);ball.vy*=Math.pow(.988,dt*60);
    }
  }

  if(ball.x <= 25){ score[1]++; resetAfterGoal(now); return; }
  if(ball.x >= W - 25){ score[0]++; resetAfterGoal(now); return; }

  if(ball.y<99||ball.y>H-119){ball.vy*=-.8;ball.y=Math.max(99,Math.min(H-119,ball.y))}

  if(ball.owner<0 && now >= ball.frozen){
    for(let i=0;i<players.length;i++){
      let p=players[i];
      if(Math.hypot(ball.x-p.x,ball.y-p.y)<(p.size+5)){
        let speed=Math.hypot(ball.vx,ball.vy);
        if(ball.shot&&speed>7){
          let dx=ball.x-p.x,dy=ball.y-p.y,d=Math.hypot(dx,dy)||1;
          ball.vx=dx/d*speed*.55;ball.vy=dy/d*speed*.55;ball.shot=false;
        }else{
          ball.owner=i;ball.vx=ball.vy=0;ball.shot=false;ball.protect=now+250;
        }
        break;
      }
    }
  }

  if(ball.owner>=0){
    let owner=players[ball.owner],opp=players.find(p=>p.team!==owner.team);
    if(opp && Math.hypot(owner.x-opp.x,owner.y-opp.y)<(owner.size+15)&&now>=ball.protect&&now>=owner.dribble){
      ball.owner=players.indexOf(opp);
      ball.protect=now+250;
    }
  }
}

function resetAfterGoal(now){
  msg='GOL!';msgUntil=now+1200;
  if(totalPlayers===6){
    players.forEach(p => p.goalie = false);
    let blueTeam = players.filter(p => p.team === 0);
    let redTeam = players.filter(p => p.team === 1);
    let randomBlue = blueTeam[Math.floor(Math.random()*blueTeam.length)];
    let randomRed = redTeam[Math.floor(Math.random()*redTeam.length)];
    randomBlue.goalie = true;
    randomRed.goalie = true;
  }
  fresh();
}

function snapshot(){
  return {players:players.map(p=>({...p})),ball:{...ball},score:[...score],remaining,match,finished,msg,msgUntil,charge:[...charge], W, H, totalPlayers}
}

function applyState(s){
  if(s.totalPlayers && s.totalPlayers !== totalPlayers){
    totalPlayers = s.totalPlayers;
    updateCanvasSize();
  }
  players=s.players;ball=s.ball;score=s.score;remaining=s.remaining;match=s.match;finished=s.finished;msg=s.msg;msgUntil=s.msgUntil;charge=s.charge;W=s.W;H=s.H;
  c.width=W; c.height=H;
}

function draw(){
  ctx.clearRect(0,0,W,H);
  ctx.fillStyle='#185d2b';ctx.fillRect(0,0,W,H);
  let cols = totalPlayers===6 ? 14 : (totalPlayers===4 ? 12 : 10);
  let step = (W-50)/cols;
  for(let i=0;i<cols;i++){
    ctx.fillStyle=i%2?'#2a9e44':'#23913c';ctx.fillRect(25+i*step,90,step,H-180);
  }
  ctx.strokeStyle='white';ctx.lineWidth=3;ctx.strokeRect(25,90,W-50,H-180);
  ctx.beginPath();ctx.moveTo(W/2,90);ctx.lineTo(W/2,H-90);ctx.stroke();
  ctx.beginPath();ctx.arc(W/2,H/2,65,0,Math.PI*2);ctx.stroke();
  
  let gH = totalPlayers===6 ? 200 : 150;
  let gTop = (H/2) - (gH/2);

  ctx.strokeRect(25,gTop,140,gH);ctx.strokeRect(25,(H/2)-75,65,150);
  ctx.strokeRect(W-165,gTop,140,gH);ctx.strokeRect(W-90,(H/2)-75,65,150);
  ctx.lineWidth=4;ctx.strokeRect(5,gTop,22,gH);ctx.strokeRect(W-27,gTop,22,gH);

  for(let i=0;i<players.length;i++){
    let p=players[i];
    let r = p.size;
    ctx.fillStyle='#145022';ctx.beginPath();ctx.ellipse(p.x,p.y+8,r-1,5,0,0,Math.PI*2);ctx.fill();
    ctx.fillStyle=performance.now()<p.dribble?p.color:'#ffffff';ctx.beginPath();ctx.arc(p.x,p.y,r,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle=p.color;ctx.lineWidth=5;ctx.beginPath();
    ctx.moveTo(p.x-7,p.y+11);ctx.lineTo(p.x-12,p.y+22);
    ctx.moveTo(p.x+7,p.y+11);ctx.lineTo(p.x+12,p.y+22);ctx.stroke();
    ctx.fillStyle='#f0cda5';ctx.beginPath();ctx.arc(p.x,p.y-(r+4),8,0,Math.PI*2);ctx.fill();
    
    ctx.fillStyle='white';ctx.font='bold 12px Arial';ctx.textAlign='center';
    let skillReady = performance.now() >= p.skillCD ? ' [F: PRONTA]' : ' [F: CD]';
    ctx.fillText(p.nick + skillReady, p.x, p.y - (r+18));

    if(ball.owner===i){ctx.fillStyle='#ffeb3c';ctx.beginPath();ctx.arc(p.x,p.y-(r+28),4,0,Math.PI*2);ctx.fill()}
  }

  ctx.fillStyle = performance.now() < ball.frozen ? '#8be9fd' : '#ff9119';
  ctx.beginPath();ctx.arc(ball.x,ball.y,9,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle='#191919';ctx.lineWidth=2;ctx.stroke();
  ctx.beginPath();ctx.moveTo(ball.x-5,ball.y-5);ctx.lineTo(ball.x+5,ball.y+5);ctx.stroke();

  ctx.fillStyle='#191919';ctx.beginPath();ctx.roundRect((W/2)-220,12,440,65,12);ctx.fill();
  ctx.fillStyle='white';ctx.font='bold 20px Arial';ctx.textAlign='center';
  ctx.fillText(`AZUL ${score[0]} x ${score[1]} VERMELHO`,W/2,40);
  ctx.fillStyle='#ffeb3c';ctx.font='bold 18px Arial';ctx.fillText(`Tempo: ${Math.ceil(remaining)}s`,W/2,64);

  if(match){
    for(let i=0;i<players.length;i++){
      if(charge[i]>0){
        let p=players[i];
        ctx.fillStyle='#222';ctx.fillRect(p.x-40,p.y-70,80,10);
        ctx.fillStyle=p.color;ctx.fillRect(p.x-40,p.y-70,80*(charge[i]/1000),10);
        ctx.strokeStyle='white';ctx.strokeRect(p.x-40,p.y-70,80,10);
      }
    }
  }

  if(!match && document.getElementById('skill-menu').style.display !== 'flex'){
    ctx.fillStyle='rgba(0,0,0,.6)';ctx.fillRect((W/2)-310,250,620,180);
    ctx.fillStyle='white';ctx.font='bold 34px Arial';ctx.fillText(finished?msg:'FUTEBOL DE BONECOS',W/2,310);
    ctx.font='bold 19px Arial';
    ctx.fillText(isLocal || role==='host'?(connected?'Clique INICIAR / REINICIAR':'Aguardando...'):'Aguardando o anfitrião iniciar',W/2,350);
    ctx.fillText('Partida de 60 segundos',W/2,385);
  }

  if(msg&&performance.now()<msgUntil){ctx.fillStyle='#ffeb3c';ctx.font='bold 34px Arial';ctx.fillText(msg,W/2,125)}
}

function loop(now){
  let dt=Math.min((now-last)/1000,.04);last=now;
  if(role==='host'||isLocal){
    update(dt,now);
    if(!isLocal&&role==='host'&&connections.length>0&&now-lastSend>33){
      let snapshotData = snapshot();
      connections.forEach(conn => {
        if(conn.open) conn.send({type:'state', state: snapshotData});
      });
      lastSend=now;
    }
  }
  draw();
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
</script></body></html>
